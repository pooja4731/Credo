pragma solidity ^0.8.20;

/**
 * @title Certificate
 * @notice Stores tamper-proof hashes of academic certificates issued by
 *         approved institutions and allows anyone to verify or revoke them.
 *
 * Design notes:
 * - Only wallets marked as `approvedIssuers` (institutions approved by the
 *   Super Admin off-chain / via `setIssuerApproval`) can issue certificates.
 * - The contract owner (deployer / platform admin wallet) controls issuer
 *   approval. In production this should be a multisig or governance
 *   contract rather than a single EOA.
 * - `certificateHash` is the SHA-256 hash (as bytes32, via keccak256 of the
 *   hex string, or a native sha256 digest truncated/handled off-chain) of
 *   the canonical certificate JSON. The backend is responsible for
 *   generating this hash identically every time so re-verification works.
 * - `ipfsCID` is stored as a string (IPFS CIDs are base58/base32, not fixed
 *   length, so bytes32 does not fit all CID versions).
 */
contract Certificate {
    address public owner;

    struct CertificateRecord {
        bytes32 certificateHash;   // SHA-256 hash of certificate JSON
        string ipfsCID;            // IPFS CID of certificate PDF + JSON
        address issuer;            // Wallet address of the issuing institution
        uint256 timestamp;         // Block timestamp at issuance
        bool revoked;              // Revocation flag
        bool exists;               // Existence flag (bytes32(0) is a valid hash)
    }

    // certificateId (e.g. keccak256 of a human-readable cert ID string) => record
    mapping(bytes32 => CertificateRecord) private certificates;

    // Reverse lookup to detect duplicate hashes (prevents re-issuing an
    // identical certificate under a different ID)
    mapping(bytes32 => bool) private usedHashes;

    // Institutions approved to issue certificates
    mapping(address => bool) public approvedIssuers;

    event Issued(
        bytes32 indexed certificateId,
        bytes32 certificateHash,
        string ipfsCID,
        address indexed issuer,
        uint256 timestamp
    );

    event Revoked(
        bytes32 indexed certificateId,
        address indexed revokedBy,
        uint256 timestamp
    );

    event IssuerApprovalChanged(address indexed institution, bool approved);

    modifier onlyOwner() {
        require(msg.sender == owner, "Certificate: caller is not the owner");
        _;
    }

    modifier onlyApprovedIssuer() {
        require(approvedIssuers[msg.sender], "Certificate: not an approved issuer");
        _;
    }

    constructor() {
        owner = msg.sender;
    }

    /**
     * @notice Approve or revoke an institution's ability to issue certificates.
     * @dev Only callable by the contract owner (platform admin wallet).
     */
    function setIssuerApproval(address institution, bool approved) external onlyOwner {
        approvedIssuers[institution] = approved;
        emit IssuerApprovalChanged(institution, approved);
    }

    /**
     * @notice Issue a new certificate on-chain.
     * @param certificateId Unique identifier for the certificate (e.g.
     *        keccak256("CRD-2026-CSE-00123")), generated by the backend.
     * @param certificateHash SHA-256 hash of the canonical certificate JSON.
     * @param ipfsCID CID returned by Pinata after pinning the certificate PDF/JSON.
     */
    function issueCertificate(
        bytes32 certificateId,
        bytes32 certificateHash,
        string calldata ipfsCID
    ) external onlyApprovedIssuer {
        require(!certificates[certificateId].exists, "Certificate: ID already used");
        require(!usedHashes[certificateHash], "Certificate: hash already issued");
        require(bytes(ipfsCID).length > 0, "Certificate: CID required");

        certificates[certificateId] = CertificateRecord({
            certificateHash: certificateHash,
            ipfsCID: ipfsCID,
            issuer: msg.sender,
            timestamp: block.timestamp,
            revoked: false,
            exists: true
        });

        usedHashes[certificateHash] = true;

        emit Issued(certificateId, certificateHash, ipfsCID, msg.sender, block.timestamp);
    }

    /**
     * @notice Revoke a previously issued certificate (e.g. found to be
     *         fraudulent, or the awarding decision was reversed).
     * @dev Only the original issuer or the contract owner may revoke.
     */
    function revokeCertificate(bytes32 certificateId) external {
        CertificateRecord storage record = certificates[certificateId];
        require(record.exists, "Certificate: does not exist");
        require(
            msg.sender == record.issuer || msg.sender == owner,
            "Certificate: not authorized to revoke"
        );
        require(!record.revoked, "Certificate: already revoked");

        record.revoked = true;

        emit Revoked(certificateId, msg.sender, block.timestamp);
    }

    /**
     * @notice Check whether a certificate ID has been issued.
     */
    function certificateExists(bytes32 certificateId) external view returns (bool) {
        return certificates[certificateId].exists;
    }

    /**
     * @notice Verify a certificate by comparing a freshly computed hash
     *         against the on-chain record, and check its revocation status.
     * @return valid True if the certificate exists, is not revoked, and the
     *         hash matches.
     * @return record Full on-chain record for display purposes.
     */
    function verifyCertificate(bytes32 certificateId, bytes32 certificateHash)
        external
        view
        returns (bool valid, CertificateRecord memory record)
    {
        record = certificates[certificateId];
        if (!record.exists) {
            return (false, record);
        }
        if (record.revoked) {
            return (false, record);
        }
        valid = (record.certificateHash == certificateHash);
        return (valid, record);
    }

    /**
     * @notice Fetch a certificate record without hash comparison (used by
     *         the verify portal to show details before/without a hash check).
     */
    function getCertificate(bytes32 certificateId)
        external
        view
        returns (CertificateRecord memory)
    {
        require(certificates[certificateId].exists, "Certificate: does not exist");
        return certificates[certificateId];
    }
}
